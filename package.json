{
  "name": "@ishioka0222/userscript",
  "version": "0.0.0",
  "private": true,
  "description": "Userscripts for Tampermonkey by Hiroki Ishioka",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node tools/check-version-bump.mjs origin/master",
    "check": "npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishioka0222/userscript.git"
  },
  "author": "Hiroki Ishioka",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-userscripts": "0.5.6",
    "globals": "17.11.0",
    "prettier": "3.9.6"
  }
}
